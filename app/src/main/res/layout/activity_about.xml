<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    style="@style/VerticalList"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:paddingLeft="20dp"
    android:paddingTop="32dp"
    android:paddingRight="20dp"
    android:paddingBottom="32dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:fadingEdge="none"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout style="@style/VerticalList">

            <LinearLayout
                style="@style/VerticalList"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/px_circle_outline"
                    android:tint="@color/text">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_launcher_monochrome"
                        android:tint="@color/text" />
                </FrameLayout>

                <View style="@style/SeparatorListHorizontal" />

                <TextView
                    android:id="@+id/name_version"
                    style="@style/H3_Center" />

                <View style="@style/SeparatorListHorizontal" />

                <TextView
                    android:id="@+id/app_description"
                    style="@style/Text_Center"
                    android:text="@string/app_desc" />

                <View style="@style/SeparatorListHorizontal" />

                <LinearLayout
                    android:id="@+id/claims"
                    style="@style/VerticalList"
                    android:gravity="center_horizontal">

                    <com.rama.mako_zero.widgets.WdLabel
                        style="@style/BlockFlow"
                        app:icon="@drawable/px_check"
                        app:text="@string/app_ads_desc" />

                    <View style="@style/SeparatorListHorizontal" />

                    <com.rama.mako_zero.widgets.WdLabel
                        style="@style/BlockFlow"
                        app:icon="@drawable/px_check"
                        app:text="@string/app_background_tasks_desc" />

                    <View style="@style/SeparatorListHorizontal" />

                    <com.rama.mako_zero.widgets.WdLabel
                        style="@style/BlockFlow"
                        app:icon="@drawable/px_check"
                        app:text="@string/app_trackers_desc" />

                    <View style="@style/SeparatorListHorizontal" />

                    <com.rama.mako_zero.widgets.WdLabel
                        style="@style/BlockFlow"
                        app:icon="@drawable/px_check"
                        app:text="@string/app_offline_desc" />

                    <View style="@style/SeparatorListHorizontal" />

                    <com.rama.mako_zero.widgets.WdLabel
                        style="@style/BlockFlow"
                        app:icon="@drawable/px_check"
                        app:text="@string/license_gpl3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Separator" />

    <Button
        android:id="@+id/go_back"
        style="@style/BTN"
        android:text="GO BACK" />
</LinearLayout>