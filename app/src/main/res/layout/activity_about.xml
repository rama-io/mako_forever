<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    style="@style/VerticalList">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout style="@style/VerticalList">
            <LinearLayout
                android:gravity="center_horizontal"
                style="@style/VerticalList">

                <ImageView
                    android:id="@+id/app_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:tint="@color/accent_1"
                    android:background="@drawable/mako"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/name_version"
                    style="@style/H3_Center" />

                <TextView
                    android:id="@+id/app_description"
                    style="@style/Text_Center" />

                <TextView
                    android:text="@string/app_name"
                    style="@style/H3" />

                <LinearLayout
                    android:id="@+id/claims"
                    android:gravity="center_horizontal"
                    style="@style/VerticalList" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        style="@style/SeparatorList"/>
    <Button
        android:id="@+id/go_back"
        android:text="GO BACK"
        style="@style/BTN1"
        />
</LinearLayout>