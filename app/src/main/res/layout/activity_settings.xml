<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    style="@style/VerticalList">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:overScrollMode="never"
        android:fadingEdge="none"
        android:scrollbars="none">
        <LinearLayout style="@style/VerticalList">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                style="@style/H2" />

            <com.rama.mako_forever.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="settings:section:system"
                app:header="System"
                app:defaultExpanded="true">

                <Button
                    android:id="@+id/activate_button"
                    android:text="SET LANCHER AS DEFAULT"
                    style="@style/BTN2" />

                <View style="@style/SeparatorListVertical"/>

                <Button
                    android:id="@+id/reset_button"
                    android:text="REFRESH LAUNCHER"
                    style="@style/BTN2" />

                <View style="@style/SeparatorListVertical"/>

                <Button
                    android:id="@+id/change_apps_button"
                    android:text="EDIT APPS"
                    style="@style/BTN2" />

                <View style="@style/SeparatorListVertical"/>

                <com.rama.mako_forever.widgets.WdCheckbox
                    android:id="@+id/prevent_home_screen_rotation"
                    android:text="Prevent screen rotation"
                    style="@style/Checkbox" />

<!--                <LinearLayout style="@style/VerticalListDivided_BG2">-->

<!--                    <TextView-->
<!--                        android:text="@string/label_zoom"-->
<!--                        style="@style/Text" />-->

<!--                    <com.rama.bohio.widgets.WdRange-->
<!--                        android:id="@+id/zoom"-->
<!--                        app:valuesArray="@array/ui_scale_steps"-->
<!--                        style="@style/BlockFlow" />-->

<!--                </LinearLayout>-->
            </com.rama.mako_forever.widgets.WdCollapsibleSection>

            <com.rama.mako_forever.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="settings:section:groups"
                app:header="Groups"
                app:defaultExpanded="true">

                <com.rama.mako_forever.widgets.WdCheckbox
                    android:id="@+id/collapse_groups_on_home"
                    android:text="Collapse groups when returning home"
                    style="@style/Checkbox" />

                <View style="@style/SeparatorListVertical"/>

                <com.rama.mako_forever.widgets.WdCheckbox
                    android:id="@+id/only_one_group_open"
                    android:text="Auto-collapse other groups"
                    style="@style/Checkbox" />

                <View style="@style/Separator"/>

                <LinearLayout
                    android:id="@+id/groups_container"
                    android:focusableInTouchMode="true"
                    style="@style/VerticalListDivided_BG2" />

                <View style="@style/SeparatorListVertical"/>

                <Button
                    android:id="@+id/add_group_button"
                    android:text="+ ADD GROUP"
                    style="@style/BTN2" />

            </com.rama.mako_forever.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical"/>

            <com.rama.mako_forever.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="settings:section:appearance"
                app:header="Themes"
                app:defaultExpanded="false">

                <RadioGroup
                    android:id="@+id/theme_group"
                    style="@style/VerticalListDivided" />
            </com.rama.mako_forever.widgets.WdCollapsibleSection>
        </LinearLayout>
    </ScrollView>
    <View
        style="@style/Separator"/>
    <Button
        android:id="@+id/go_about"
        android:text="ABOUT"
        style="@style/BTN2"
    />
    <View
        style="@style/SeparatorListHorizontal"/>
    <Button
        android:id="@+id/go_back"
        android:text="GO BACK"
        style="@style/BTN1"
        />
</LinearLayout>